 fi
diff --git a/Sources/BugVoiceMCP/main.swift b/Sources/BugVoiceMCP/main.swift
new file mode 100644
index 0000000..2ea94fe
--- /dev/null
+++ b/Sources/BugVoiceMCP/main.swift
@@ -0,0 +1,56 @@
+import Foundation
+import MCPKit
+
+// bugvoice-mcp: the MCP stdio server agents start. It lives in
+// BugVoice.app/Contents/MacOS and forwards tool calls to the running app.
+// Only protocol lines go to stdout; diagnostics (never content) go to stderr.
+
+let executable = (Bundle.main.executableURL ?? URL(fileURLWithPath: CommandLine.arguments[0])).resolvingSymlinksInPath()
+let appBundle = executable.deletingLastPathComponent().deletingLastPathComponent().deletingLastPathComponent()
+
+func bundleVersion(_ bundle: URL) -> String {
+    let plist = bundle.appendingPathComponent("Contents/Info.plist")
+    guard let data = try? Data(contentsOf: plist),
+          let info = try? PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any],
+          let version = info["CFBundleShortVersionString"] as? String
+    else { return "0" }
+    return version
+}
+
+func diagnose(_ message: String) {
+    FileHandle.standardError.write(Data("bugvoice-mcp: \(message)\n".utf8))
+}
+
+final class StandardOutput: @unchecked Sendable {
+    private let lock = NSLock()
+
+    func write(_ data: Data) {
+        lock.withLock { FileHandle.standardOutput.write(data) }
+    }
+}
+
+let stdout = StandardOutput()
+let bridge = MCPBridge(
+    paths: .standard(),
+    appVersion: bundleVersion(appBundle),
+    launchApp: {
+        diagnose("BugVoice is not running; opening it in the background.")
+        let open = Process()
+        open.executableURL = URL(fileURLWithPath: "/usr/bin/open")
+        open.arguments = ["-g", "-a", appBundle.path]
+        open.standardOutput = FileHandle.nullDevice
+        open.standardError = FileHandle.standardError
+        do { try open.run() } catch { diagnose("Could not open BugVoice.") }
+    },
+    output: { stdout.write($0) }
+)
+
+// Requests run concurrently so a ping is answered while an ask is still running.
+// At end of input, unfinished calls complete before the process exits.
+await withTaskGroup(of: Void.self) { group in
+    while let line = readLine(strippingNewline: true) {
+        guard !line.trimmingCharacters(in: .whitespaces).isEmpty else { continue }
+        group.addTask { await bridge.handle(line: Data(line.utf8)) }
+    }
+}
+exit(0)
diff --git a/Sources/MCPKit/MCPBridge.swift b/Sources/MCPKit/MCPBridge.swift
new file mode 100644
index 0000000..2ea4b8c
--- /dev/null
+++ b/Sources/MCPKit/MCPBridge.swift
@@ -0,0 +1,138 @@
+import Foundation
+import VoiceCore
+
+/// The stdio side of `bugvoice-mcp`: answers the MCP handshake and tool list
+/// itself and forwards each tool call to the app over the socket.
+public final class MCPBridge: @unchecked Sendable {
+    public static let didNotStart = "BugVoice did not start. Open it and try again."
+    public static let connectionLost = "BugVoice closed the connection. Try again."
+    public static let lostAfterSending = "BugVoice closed the connection before answering. Check BugVoice before you try again."
+
+    /// Tools that change nothing, so sending one twice is harmless.
+    static let readOnly: Set<MCPTool> = [.listFolders, .listNotes, .getNote, .listMeetings, .getMeeting, .search, .ask, .getJob]
+
+    private let paths: MCPSocketPaths
+    private let appVersion: String
+    private let launchApp: @Sendable () -> Void
+    private let waitSeconds: Double
+    private let output: @Sendable (Data) -> Void
+
+    private let lock = NSLock()
+    private var clientName = "agent"
+    private var client: MCPSocketClient?
+    private var launched = false
+
+    public init(
+        paths: MCPSocketPaths, appVersion: String, launchApp: @escaping @Sendable () -> Void,
+        waitSeconds: Double = 20, output: @escaping @Sendable (Data) -> Void
+    ) {
+        self.paths = paths
+        self.appVersion = appVersion
+        self.launchApp = launchApp
+        self.waitSeconds = waitSeconds
+        self.output = output
+    }
+
+    /// One stdin line in; zero or one stdout line out.
+    public func handle(line: Data) async {
+        let message: JSONRPCMessage
+        switch JSONRPCMessage.parse(line) {
+        case .failure(let error):
+            output(JSONRPCMessage(id: .null, error: error).encodedLine())
+            return
+        case .success(let parsed):
+            message = parsed
+        }
+        // Responses from the client and notifications get no reply.
+        guard let method = message.method, let id = message.id else { return }
+
+        switch method {
+        case "initialize":
+            let name = message.params?["clientInfo"]?["name"]?.stringValue ?? ""
+            lock.withLock { clientName = name.isEmpty ? "agent" : name }
+            let version = MCPProtocol.negotiate(message.params?["protocolVersion"]?.stringValue)
+            reply(id, MCPProtocol.initializeResult(version: version, appVersion: appVersion))
+        case "ping":
+            reply(id, .object([:]))
+        case "tools/list":
+            reply(id, MCPTools.definitions)
+        case "tools/call":
+            guard let name = message.params?["name"]?.stringValue else {
+                output(JSONRPCMessage(
+                    id: id, error: JSONRPCError(code: JSONRPCError.invalidParams, message: "Missing tool name.")
+                ).encodedLine())
+                return
+            }
+            let arguments = message.params?["arguments"]
+            if case .failure(let error) = MCPTools.check(name, arguments) {
+                reply(id, MCPProtocol.toolResult(text: error.message, isError: true))
+                return
+            }
+            let (text, isError) = await forward(tool: name, arguments: arguments)
+            reply(id, MCPProtocol.toolResult(text: text, isError: isError))
+        default:
+            output(JSONRPCMessage(
+                id: id, error: JSONRPCError(code: JSONRPCError.methodNotFound, message: "Method not found: \(method).")
+            ).encodedLine())
+        }
+    }
+
+    private func reply(_ id: JSONValue, _ result: JSONValue) {
+        output(JSONRPCMessage(id: id, result: result).encodedLine())
+    }
+
+    private func forward(tool: String, arguments: JSONValue?) async -> (String, Bool) {
+        let name = lock.withLock { clientName }
+        let request = MCPWireRequest(id: UUID().uuidString, tool: tool, arguments: arguments, client: name)
+        // A closed connection usually means the app restarted: reconnect once. A
+        // tool that changes something is resent only when the app never got it.
+        let mayResend = MCPTool(rawValue: tool).map(Self.readOnly.contains) ?? false
+        for _ in 0..<2 {
+            guard let client = await connection() else { return (Self.didNotStart, true) }
+            do {
+                let response = try await client.send(request)
+                return (response.text, response.isError)
+            } catch {
+                drop(client)
+                if !mayResend, error as? MCPSocketError != .notSent { return (Self.lostAfterSending, true) }
+            }
+        }
+        return (Self.connectionLost, true)
+    }
+
+    /// The open connection, or a new one. Launches the app once per bridge
+    /// process when nothing listens, then waits up to `waitSeconds`.
+    private func connection() async -> MCPSocketClient? {
+        if let open = lock.withLock({ client.flatMap { $0.isClosed ? nil : $0 } }) { return open }
+        if let fresh = try? MCPSocketClient.connect(paths: paths) { return keep(fresh) }
+
+        let shouldLaunch = lock.withLock {
+            defer { launched = true }
+            return !launched
+        }
+        if shouldLaunch { launchApp() }
+
+        let deadline = Date().addingTimeInterval(waitSeconds)
+        while Date() < deadline {
+            try? await Task.sleep(for: .milliseconds(250))
+            if let fresh = try? MCPSocketClient.connect(paths: paths) { return keep(fresh) }
+        }
+        return nil
+    }
+
+    private func keep(_ fresh: MCPSocketClient) -> MCPSocketClient {
+        // Another call may have connected meanwhile; keep one connection.
+        let kept = lock.withLock {
+            if let client, !client.isClosed { return client }
+            client = fresh
+            return fresh
+        }
+        if kept !== fresh { fresh.close() }
+        return kept
+    }
+
+    private func drop(_ stale: MCPSocketClient) {
+        stale.close()
+        lock.withLock { if client === stale { client = nil } }
+    }
+}
diff --git a/Tests/MCPKitTests/MCPBridgeTests.swift b/Tests/MCPKitTests/MCPBridgeTests.swift
new file mode 100644
index 0000000..c235236
--- /dev/null
+++ b/Tests/MCPKitTests/MCPBridgeTests.swift
@@ -0,0 +1,192 @@
+import Foundation
+import Testing
+import VoiceCore
+@testable import MCPKit
+
+/// Collects what the bridge writes to stdout and what the fake app saw.
+final class Recorder: @unchecked Sendable {
+    private let lock = NSLock()
+    private var _lines: [JSONValue] = []
+    private var _requests: [MCPWireRequest] = []
+    private var _launches = 0
+
+    func output(_ data: Data) {
+        let s = String(decoding: data, as: UTF8.self)
+        #expect(s.hasSuffix("\n") && !s.dropLast().contains("\n"))
+        let v = (try? JSONDecoder().decode(JSONValue.self, from: data)) ?? .null
+        lock.lock(); _lines.append(v); lock.unlock()
+    }
+    func saw(_ r: MCPWireRequest) { lock.lock(); _requests.append(r); lock.unlock() }
+    func launched() { lock.lock(); _launches += 1; lock.unlock() }
+
+    var lines: [JSONValue] { lock.lock(); defer { lock.unlock() }; return _lines }
+    var requests: [MCPWireRequest] { lock.lock(); defer { lock.unlock() }; return _requests }
+    var launches: Int { lock.lock(); defer { lock.unlock() }; return _launches }
+}
+
+private func line(_ s: String) -> Data { Data(s.utf8) }
+
+private func call(_ id: Int, _ name: String, _ arguments: String = "{}") -> Data {
+    line(#"{"jsonrpc":"2.0","id":\#(id),"method":"tools/call","params":{"name":"\#(name)","arguments":\#(arguments)}}"#)
+}
+
+private let initialize = line(#"{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-03-26","clientInfo":{"name":"claude-code"}}}"#)
+
+private func fakeApp(_ paths: MCPSocketPaths, _ recorder: Recorder, text: String = "ok") -> MCPSocketServer {
+    MCPSocketServer(paths: paths) { r in
+        recorder.saw(r)
+        return MCPWireResponse(id: r.id, text: text, isError: false)
+    }
+}
+
+private func bridge(_ paths: MCPSocketPaths, _ recorder: Recorder, wait: Double = 2, launch: @escaping @Sendable () -> Void = {}) -> MCPBridge {
+    MCPBridge(
+        paths: paths, appVersion: "1.3",
+        launchApp: { recorder.launched(); launch() },
+        waitSeconds: wait, output: { recorder.output($0) })
+}
+
+@Suite(.serialized)
+struct MCPBridgeTests {
+    @Test func handshake() async {
+        let paths = shortTempPaths()
+        let recorder = Recorder()
+        let b = bridge(paths, recorder)
+        await b.handle(line: initialize)
+        #expect(recorder.lines.count == 1)
+        let first = recorder.lines.first
+        #expect(first?["id"] == .number(1))
+        #expect(first?["result"]?["protocolVersion"] == .string("2025-03-26"))
+        #expect(first?["result"]?["serverInfo"]?["version"] == .string("1.3"))
+        await b.handle(line: line(#"{"jsonrpc":"2.0","method":"notifications/initialized"}"#))
+        #expect(recorder.lines.count == 1)
+        await b.handle(line: line(#"{"jsonrpc":"2.0","id":"p","method":"ping"}"#))
+        #expect(recorder.lines.last?["id"] == .string("p"))
+        #expect(recorder.lines.last?["result"] == .object([:]))
+    }
+
+    @Test func toolsListWorksWithoutApp() async {
+        let paths = shortTempPaths()
+        let recorder = Recorder()
+        await bridge(paths, recorder).handle(line: line(#"{"jsonrpc":"2.0","id":2,"method":"tools/list"}"#))
+        #expect(recorder.lines.first?["result"]?["tools"]?.arrayValue?.count == 12)
+        #expect(recorder.launches == 0)
+    }
+
+    @Test func forwardsToolCall() async throws {
+        let paths = shortTempPaths()
+        defer { removeTemp(paths) }
+        let recorder = Recorder()
+        let server = fakeApp(paths, recorder)
+        try server.start()
+        defer { server.stop() }
+        let b = bridge(paths, recorder)
+        await b.handle(line: initialize)
+        await b.handle(line: call(7, "list_notes", #"{"limit":2}"#))
+        let reply = recorder.lines.last
+        #expect(reply?["id"] == .number(7))
+        #expect(reply?["result"]?["content"]?.arrayValue?.first?["text"] == .string("ok"))
+        #expect(reply?["result"]?["isError"] == .bool(false))
+        #expect(recorder.requests.first?.client == "claude-code")
+        #expect(recorder.requests.first?.tool == "list_notes")
+        #expect(recorder.requests.first?.arguments == .object(["limit": .number(2)]))
+        await b.handle(line: call(8, "list_folders"))
+        #expect(recorder.requests.count == 2)
+        #expect(recorder.launches == 0)
+    }
+
+    @Test func reconnectsAfterAppRestart() async throws {
+        let paths = shortTempPaths()
+        defer { removeTemp(paths) }
+        let recorder = Recorder()
+        let first = fakeApp(paths, recorder)
+        try first.start()
+        let b = bridge(paths, recorder)
+        await b.handle(line: call(1, "list_folders"))
+        first.stop()
+        let second = fakeApp(paths, recorder, text: "again")
+        try second.start()
+        defer { second.stop() }
+        try await Task.sleep(for: .milliseconds(100))
+        await b.handle(line: call(2, "list_folders"))
+        #expect(recorder.lines.last?["result"]?["content"]?.arrayValue?.first?["text"] == .string("again"))
+    }
+
+    @Test func writeToolIsNotResentAfterTheAppReceivedIt() async throws {
+        let paths = shortTempPaths()
+        defer { removeTemp(paths) }
+        let raw = try RawServer(paths: paths)
+        defer { raw.stop() }
+        let recorder = Recorder()
+        await bridge(paths, recorder).handle(line: call(10, "create_note", #"{"title":"T","body":"b"}"#))
+        #expect(raw.lines == 1)
+        let result = recorder.lines.last?["result"]
+        #expect(result?["isError"] == .bool(true))
+        #expect(result?["content"]?.arrayValue?.first?["text"] == .string(MCPBridge.lostAfterSending))
+    }
+
+    @Test func readToolIsResentOnce() async throws {
+        let paths = shortTempPaths()
+        defer { removeTemp(paths) }
+        let raw = try RawServer(paths: paths)
+        defer { raw.stop() }
+        let recorder = Recorder()
+        await bridge(paths, recorder).handle(line: call(11, "list_folders"))
+        #expect(raw.lines == 2)
+        #expect(recorder.lines.last?["result"]?["content"]?.arrayValue?.first?["text"] == .string(MCPBridge.connectionLost))
+    }
+
+    @Test func argumentErrorNotForwarded() async throws {
+        let paths = shortTempPaths()
+        defer { removeTemp(paths) }
+        let recorder = Recorder()
+        let server = fakeApp(paths, recorder)
+        try server.start()
+        defer { server.stop() }
+        await bridge(paths, recorder).handle(line: call(3, "search"))
+        let result = recorder.lines.last?["result"]
+        #expect(result?["isError"] == .bool(true))
+        #expect(result?["content"]?.arrayValue?.first?["text"] == .string("query must be a non-empty string."))
+        #expect(recorder.requests.isEmpty)
+    }
+
+    @Test func launchesAppWhenSocketMissing() async throws {
+        let paths = shortTempPaths()
+        defer { removeTemp(paths) }
+        let recorder = Recorder()
+        let server = fakeApp(paths, recorder)
+        defer { server.stop() }
+        let b = bridge(paths, recorder, wait: 5) {
+            DispatchQueue.global().asyncAfter(deadline: .now() + 0.5) { try? server.start() }
+        }
+        await b.handle(line: call(4, "list_folders"))
+        #expect(recorder.lines.last?["result"]?["content"]?.arrayValue?.first?["text"] == .string("ok"))
+        #expect(recorder.launches == 1)
+    }
+
+    @Test func reportsDidNotStart() async {
+        let paths = shortTempPaths()
+        let recorder = Recorder()
+        let b = bridge(paths, recorder, wait: 0.5)
+        await b.handle(line: call(5, "list_folders"))
+        let result = recorder.lines.last?["result"]
+        #expect(result?["isError"] == .bool(true))
+        #expect(result?["content"]?.arrayValue?.first?["text"] == .string("BugVoice did not start. Open it and try again."))
+        await b.handle(line: call(6, "list_folders"))
+        #expect(recorder.launches == 1)
+    }
+
+    @Test func unknownMethod() async {
+        let recorder = Recorder()
+        await bridge(shortTempPaths(), recorder).handle(line: line(#"{"jsonrpc":"2.0","id":9,"method":"resources/list"}"#))
+        #expect(recorder.lines.first?["error"]?["code"] == .number(-32601))
+        #expect(recorder.lines.first?["id"] == .number(9))
+    }
+
+    @Test func garbageLine() async {
+        let recorder = Recorder()
+        await bridge(shortTempPaths(), recorder).handle(line: line("nope"))
+        #expect(recorder.lines.first?["error"]?["code"] == .number(-32700))
+        #expect(recorder.lines.first?["id"] == .null)
+    }
+}
